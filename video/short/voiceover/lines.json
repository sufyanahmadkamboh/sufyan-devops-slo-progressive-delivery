 {
  "id": "l12",
  "voice": "Steve",
  "settings": {
   "model": "mtl_tts",
   "exaggeration": 0.65,
   "cfg_weight": 0.4,
   "seed": 3000
  },
  "tts": "Slow instead of broken? Six hundred milliseconds of extra latency. Caught in forty-three seconds."
